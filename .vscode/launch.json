{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "placeify_flutter (Chrome)",
            "cwd": "${workspaceFolder}/placeify_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome"
        },
        {
            "name": "placeify_flutter (Android)",
            "cwd": "${workspaceFolder}/placeify_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "android"
        },
        {
            "name": "placeify_flutter (macOS — requires Xcode)",
            "cwd": "${workspaceFolder}/placeify_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "macos"
        },
        {
            "name": "placeify_server",
            "cwd": "${workspaceFolder}/placeify_server",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "docker_compose_up",
            "program": "bin/main.dart",
            "env": {
                "SERVERPOD_PASSWORD_database": "P-noAmM0ExkfSxz5pCS_iOnJ6SwkE71B"
            },
            "args": [
                "--apply-migrations"
            ]
        }
    ],
    "compounds": [
        {
            "name": "placeify (full stack)",
            "configurations": [
                "placeify_server",
                "placeify_flutter (Chrome)"
            ],
            "presentation": {
                "order": 1
            }
        }
    ]
}
