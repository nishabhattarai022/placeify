# Copy to passwords.yaml (gitignored) or set SERVERPOD_PASSWORD_* env vars.
# cp config/passwords.yaml.example config/passwords.yaml

shared:
  # Email (available in all run modes via SERVERPOD_PASSWORD_*)
  emailProvider: "console"
  emailFrom: "Placeify <noreply@placeify.app>"
  # resendApiKey: set via SERVERPOD_PASSWORD_resendApiKey in staging/production
  # smtpHost: "smtp.example.com"
  # smtpPort: "587"
  # smtpUser: "apikey"
  # smtpPassword: "secret"

development:
  database: "P-noAmM0ExkfSxz5pCS_iOnJ6SwkE71B"
  redis: "UFox4R-3vSC8hPsPRodDaUaLRU1n4Dsr"
  serviceSecret: "placeify_dev_service_secret_change_in_production"
  emailSecretHashPepper: "placeify_dev_email_pepper_change_in_production"
  jwtRefreshTokenHashPepper: "placeify_dev_refresh_pepper_change_in_production"
  jwtHmacSha512PrivateKey: "placeify_dev_jwt_private_key_change_in_production"

test:
  database: "ajzc6u1uPyDjeg0SXp61RXK22hm7mqsJ"
  redis: "Ae3cNAo_yL9CdlS4MIJa_DycO050OwG6"
  serviceSecret: "placeify_test_service_secret"
  emailSecretHashPepper: "placeify_test_email_pepper"
  jwtRefreshTokenHashPepper: "placeify_test_refresh_pepper"
  jwtHmacSha512PrivateKey: "placeify_test_jwt_private_key"

staging:
  database: "REPLACE_WITH_STAGING_DB_PASSWORD"
  redis: "REPLACE_WITH_STAGING_REDIS_PASSWORD"
  serviceSecret: "REPLACE_MIN_20_CHARS_STAGING_SECRET"
  emailSecretHashPepper: "REPLACE_STAGING_EMAIL_PEPPER"
  jwtRefreshTokenHashPepper: "REPLACE_STAGING_REFRESH_PEPPER"
  jwtHmacSha512PrivateKey: "REPLACE_STAGING_JWT_PRIVATE_KEY"
  emailProvider: "resend"
  emailFrom: "Placeify <noreply@placeify.app>"
  resendApiKey: "REPLACE_WITH_RESEND_API_KEY"

production:
  database: "REPLACE_WITH_PRODUCTION_DB_PASSWORD"
  redis: "REPLACE_WITH_PRODUCTION_REDIS_PASSWORD"
  serviceSecret: "REPLACE_MIN_20_CHARS_PRODUCTION_SECRET"
  emailSecretHashPepper: "REPLACE_PRODUCTION_EMAIL_PEPPER"
  jwtRefreshTokenHashPepper: "REPLACE_PRODUCTION_REFRESH_PEPPER"
  jwtHmacSha512PrivateKey: "REPLACE_PRODUCTION_JWT_PRIVATE_KEY"
  emailProvider: "resend"
  emailFrom: "Placeify <noreply@placeify.app>"
  resendApiKey: "REPLACE_WITH_RESEND_API_KEY"
